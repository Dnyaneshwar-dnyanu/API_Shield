# ==============================================================================
# APIShield — Root Environment Configuration Template
# Copy to .env in local root or use for Docker Compose deployments
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=root_password
DB_NAME=apishield_user
DB_USERNAME=apishield
DB_PASSWORD=apishield_dev_secret

# Redis In-Memory Tier
REDIS_HOST=localhost
REDIS_PORT=6379

# Apache Kafka Event Bus
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVER=localhost:9092

# Service Discovery (Eureka Server)
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Security & JWT Configuration
JWT_SECRET=d3f4u1t-s3cur3-256-b1t-jwt-s3cr3t-k3y-f0r-d3v3l0pm3nt-0nly!
JWT_ISSUER=apishield-auth-service
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Edge API Gateway Internal Secret (HMAC)
INTERNAL_GATEWAY_SECRET=apishield-internal-gateway-token-secret-change-in-prod!

# Razorpay Payment Gateway (Initial Provider)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Observability Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
